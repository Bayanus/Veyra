#pragma kernel Update

struct Particle
{
    float3 position;
    float3 velocity;
    float age;
    float seed;
};

struct FieldData
{
    float4 positionRadius;
    float4 typeStrength;
};

RWStructuredBuffer<Particle> Particles;
StructuredBuffer<FieldData> Fields;

uint ParticleCount;
uint FieldCount;
uint BurstCount;
uint LoopEmitter;
uint EmitterSeed;
float DeltaTime;
float TimeValue;
float Lifetime;
float3 InitialVelocity;
float3 EmitterPosition;

float hash11(float p)
{
    p = frac(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return frac(p);
}

float3 randomDirection(float seed)
{
    float a = hash11(seed + 1.7) * 6.2831853;
    float z = hash11(seed + 9.2) * 2.0 - 1.0;
    float r = sqrt(max(0.0, 1.0 - z * z));
    return float3(cos(a) * r, z, sin(a) * r);
}

void Spawn(inout Particle p, uint id)
{
    p.seed = hash11((float)id * 17.13 + (float)EmitterSeed + floor(TimeValue * 8.0));
    p.position = EmitterPosition;
    p.velocity = InitialVelocity + randomDirection(p.seed) * 0.001;
    p.age = 0.0001;
}

[numthreads(256, 1, 1)]
void Update(uint id : SV_DispatchThreadID)
{
    if (id >= ParticleCount) return;

    uint activeCount = BurstCount > 0 ? min(BurstCount, ParticleCount) : ParticleCount;
    Particle p = Particles[id];

    if (id >= activeCount)
    {
        p.age = -1.0;
        Particles[id] = p;
        return;
    }

    if (p.age <= 0.0)
    {
        Spawn(p, id);
    }
    else if (p.age >= Lifetime)
    {
        if (LoopEmitter != 0)
            Spawn(p, id);
        else
        {
            p.age = -1.0;
            Particles[id] = p;
            return;
        }
    }
    else
    {
        float3 acceleration = 0.0;

        for (uint i = 0; i < FieldCount; i++)
        {
            FieldData field = Fields[i];
            float3 offset = p.position - field.positionRadius.xyz;
            float distance = length(offset);
            float radius = max(field.positionRadius.w, 0.001);
            if (distance > radius && field.typeStrength.x != 0.0) continue;

            float falloff = 1.0 - saturate(distance / radius);
            float strength = field.typeStrength.y * falloff;
            uint type = (uint)field.typeStrength.x;

            if (type == 0) // Gravity
                acceleration += float3(0, -strength, 0);
            else if (type == 1) // Radial
                acceleration += (distance > 0.0001 ? normalize(offset) : 0.0) * strength;
            else if (type == 2) // Vortex around Y
                acceleration += (distance > 0.0001 ? normalize(float3(-offset.z, 0, offset.x)) : 0.0) * strength;
            else if (type == 3) // Turbulence
                acceleration += float3(
                    sin(TimeValue * 2.1 + p.position.y * 1.7 + p.seed * 11.0),
                    cos(TimeValue * 1.7 + p.position.x * 1.3 + p.seed * 7.0),
                    sin(TimeValue * 2.7 + p.position.z * 1.9 + p.seed * 5.0)) * strength;
        }

        p.velocity += acceleration * DeltaTime;
        p.position += p.velocity * DeltaTime;
        p.age += DeltaTime;
    }

    Particles[id] = p;
}
